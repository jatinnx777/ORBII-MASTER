<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally empty splash icon. ORBII's launch screen is now just the
     solid brand colour with no logo. A transparent drawable is used (rather
     than removing windowSplashScreenAnimatedIcon) so Android 12+ does not fall
     back to drawing the launcher icon in the splash. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@android:color/transparent" />
  <size android:width="1dp" android:height="1dp" />
</shape>
