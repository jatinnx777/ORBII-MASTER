{
  "expo": {
    "name": "ORBII Circle",
    "slug": "orbii-circle",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orbiicircle",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.orbii.circle",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ORBII Circle shows you where someone in your circle is when they raise an alarm.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.orbii.circle",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF9EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#EF605E"
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
